{
  "name": "abugikha",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@abugikha/web",
    "dev:api": "turbo run dev --filter=@abugikha/api",
    "dev:mobile": "bun --cwd apps/mobile start",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check": "turbo run typecheck lint test"
  },
  "devDependencies": {
    "turbo": "^2.11.5",
    "typescript": "^5.9.3"
  }
}
