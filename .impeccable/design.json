  "components": [],
  "narrative": {
    "northStar": "The Calm Poster",
    "overview": "Warm cream canvas, enormous condensed uppercase type, one saturated color per section and scroll-driven reveals; glyph colors carry meaning.",
    "keyCharacteristics": [
      "Cream canvas with generous whitespace",
      "One saturated color per section",
      "Huge condensed uppercase headings",
      "Square everywhere; circles only as motif and marks",
      "Scroll-driven storytelling with smooth inertia"
    ],
    "rules": [
      {
        "name": "The Meaning-Only Color Rule",
        "body": "Saturated hues appear only to mark a consonant class, a tone, a vowel, a final or a removed part. A hue used for decoration steals meaning from the learner.",
        "section": "colors"
      },
      {
        "name": "The No-Pure-Black Rule",
        "body": "Neither paper nor ink is ever #fff or #000. Contrast must read as comfortable, not stark.",
        "section": "colors"
      },
      {
        "name": "The Theme Variable Rule",
        "body": "Colors are always read from `--color-*` variables (set by the theme, never literals), so every theme and every custom syllable-part color works everywhere.",
        "section": "colors"
      },
      {
        "name": "The Thai-First Rule",
        "body": "A Thai glyph is always the largest element in its group. IPA and RTGS sit below it in the smaller IPA or sans face.",
        "section": "typography"
      },
      {
        "name": "The Specimen Rule",
        "body": "When letters are compared (looped, loopless, handwriting), render each in its own real font. Never fake a style with weight or slant.",
        "section": "typography"
      },
      {
        "name": "The Glow-on-Action Rule",
        "body": "A glow, ring or pulse means \"this is a live target or the result of your action\". Never use one at rest.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** read every color from a `--color-*` variable so themes and custom syllable-part colors apply everywhere.",
      "**Do** set Thai glyphs in Noto Serif Thai at the largest size in their group, with IPA and RTGS beneath.",
      "**Do** use the notched `.btn` for actions and the paper-and-tape treatment for content that \"lives on a page\".",
      "**Do** respect `prefers-reduced-motion`: transitions drop to near zero and loops stop.",
      "**Do** keep contrast comfortable: ink on paper, never pure black on white."
    ],
    "donts": [
      "Don't use the poster palette, outlined type or flush tiles outside the home page until a tool page is deliberately migrated.",
      "Don't put white text on red or red text on cream; they fail AA.",
      "Don't put an eyebrow or kicker pill above a heading.",
      "Don't loop ambient motion (floating glyphs, marquees) behind content.",
      "**Don't** use saturated color as decoration; it belongs to class, tone, vowel, final and removed parts.",
      "**Don't** put glow, pulse or lift on resting elements.",
      "**Don't** use pure white (#fff) or pure black (#000) for surfaces or text.",
      "**Don't** fake Thai letterform styles with weight or slant; use the real specimen fonts.",
      "**Don't** hard-code user-facing strings or colors; copy comes from `packages/i18n`, color from theme variables."
    ]
  }
}